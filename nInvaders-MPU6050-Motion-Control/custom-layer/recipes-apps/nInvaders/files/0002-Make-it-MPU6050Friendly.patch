+/**
+ * Find MPU6050 device
+ */
+static void find_mpu_device(void)
+{
+    printf("Searching for MPU6050 device...\n");
+    
+    // Try predefined paths
+    for (int i = 0; mpu_y_paths[i] != NULL; i++) {
+        int fd = open(mpu_y_paths[i], O_RDONLY);
+        if (fd >= 0) {
+            char buf[32];
+            ssize_t n = read(fd, buf, sizeof(buf) - 1);
+            close(fd);
+            
+            if (n > 0) {
+                strcpy(mpu_y_path, mpu_y_paths[i]);
+                strcpy(mpu_z_path, mpu_z_paths[i]);
+                mpu_available = 1;
+                printf("MPU6050 device found: %s\n", mpu_y_path);
+                return;
+            }
+        }
+    }
+    
+    // Dynamic search in sysfs
+    DIR *dir = opendir("/sys/bus/iio/devices/");
+    if (dir) {
+        struct dirent *entry;
+        while ((entry = readdir(dir)) != NULL) {
+            if (strstr(entry->d_name, "iio:device")) {
+                char test_path[256];
+                snprintf(test_path, sizeof(test_path),
+                        "/sys/bus/iio/devices/%s/in_accel_y_raw", entry->d_name);
+                
+                int fd = open(test_path, O_RDONLY);
+                if (fd >= 0) {
+                    char buf[32];
+                    ssize_t n = read(fd, buf, sizeof(buf) - 1);
+                    close(fd);
+                    
+                    if (n > 0) {
+                        snprintf(mpu_y_path, sizeof(mpu_y_path),
+                                "/sys/bus/iio/devices/%s/in_accel_y_raw", entry->d_name);
+                        snprintf(mpu_z_path, sizeof(mpu_z_path),
+                                "/sys/bus/iio/devices/%s/in_accel_z_raw", entry->d_name);
+                        mpu_available = 1;
+                        printf("MPU6050 device found: %s\n", mpu_y_path);
+                        closedir(dir);
+                        return;
+                    }
+                }
+            }
+        }
+        closedir(dir);
+    }
+    
+    if (!mpu_available) {
+        printf("MPU6050 device not found. Using keyboard only.\n");
+    }
+}
+
+/**
+ * Read value from MPU6050
+ */
+static int read_mpu_value(const char *path)
+{
+    if (!mpu_available || strlen(path) == 0) return 0;
+    
+    int fd = open(path, O_RDONLY);
+    if (fd < 0) {
+        mpu_available = 0;
+        return 0;
+    }
+    
+    char buf[32];
+    ssize_t n = read(fd, buf, sizeof(buf) - 1);
+    close(fd);
+    
+    if (n > 0) {
+        buf[n] = '\0';
+        return atoi(buf);
+    }
+    return 0;
+}
